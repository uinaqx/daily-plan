{
  "name": "daily-plan",
  "version": "2.0.0",
  "description": "每日计划 - 支持Web和Android APK的跨平台任务管理应用",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "android:init": "npx cap init DailyPlan com.dailyplan.app --web-dir=dist",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run build && npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "keywords": [
    "daily-plan",
    "task-manager",
    "productivity",
    "android",
    "capacitor"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.3.3",
    "@capacitor/cli": "^8.3.3",
    "@capacitor/core": "^8.3.3",
    "vite": "^8.0.11"
  }
}
